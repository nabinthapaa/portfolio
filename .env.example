# EmailJS credentials for the contact form.
# Next.js only exposes variables prefixed with NEXT_PUBLIC_ to the browser,
# so these replace the previous VITE_* names.
NEXT_PUBLIC_EMAILJS_SERVICE=
NEXT_PUBLIC_EMAILJS_TEMPLATE=
NEXT_PUBLIC_EMAILJS_PUBLIC=
NEXT_PUBLIC_EMAILJS_TO_NAME=
NEXT_PUBLIC_EMAILJS_TO_EMAIL=

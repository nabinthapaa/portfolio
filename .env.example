# SMTP credentials for the contact form. These are read only on the server
# (src/app/api/contact/route.ts) and must NOT be prefixed with NEXT_PUBLIC_,
# which would inline them into the browser bundle.
#
# Copy to .env.local for development. In production set them in the Netlify UI
# or: netlify env:set SMTP_PASS <value> --context production --secret
SMTP_HOST=
SMTP_PORT=465
# Defaults to true when SMTP_PORT is 465, false otherwise.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Where contact form messages are delivered.
CONTACT_TO_EMAIL=
# Optional. Defaults to SMTP_USER. Must be an address the SMTP account may
# send as, or SPF/DKIM will fail.
CONTACT_FROM_EMAIL=
